# Docker ignore patterns
# These files/directories won't be copied into the Docker image

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
ENV/
env/
*.egg-info/
dist/
build/
.eggs/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Git
.git/
.gitignore

# Docker
Dockerfile
docker-compose*.yml
.dockerignore

# Documentation
*.md
docs/

# Development files
.env
.env.*
*.log
*.db
*.sqlite
*.sqlite3

# OS
.DS_Store
Thumbs.db

# Frontend (if building separately)
frontend/node_modules/
frontend/dist/
frontend/.next/