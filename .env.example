# TSM Configuration
# Copy this file to .env and customize as needed

# Application
TSM_APP_NAME=TSM
TSM_DEBUG=false
TSM_VERSION=0.2.0

# Database
TSM_DATABASE_PATH=tsm.db
TSM_DATABASE_TIMEOUT=5.0

# API Server
TSM_API_HOST=0.0.0.0
TSM_API_PORT=8000
TSM_API_PREFIX=/api

# Logging
TSM_LOG_LEVEL=INFO
# TSM_LOG_FILE=logs/tsm.log

# Crawler
TSM_CRAWLER_TIMEOUT=10.0
TSM_CRAWLER_USER_AGENT=TSM-Crawler/0.2.0
TSM_CRAWLER_MAX_RETRIES=3
TSM_CRAWLER_DELAY=1.0

# Scheduler
TSM_SCHEDULER_ENABLED=true
TSM_CRAWL_INTERVAL_HOURS=1

# Security
# TSM_SECRET_KEY=your-secret-key-here
TSM_RATE_LIMIT_PER_MINUTE=60

# Feature Flags
TSM_ENABLE_ANALYTICS=true
TSM_ENABLE_ALERTS=true
TSM_ENABLE_REPORTS=true
